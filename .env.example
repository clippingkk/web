# Core runtime
DATABASE_URL=postgresql://postgres:admin@127.0.0.1:5432/clippingkk
DATABASE_POOL_MAX=10
REDIS_URL=redis://127.0.0.1:6379/1
QUEUE_REDIS_URL=redis://127.0.0.1:6379/2
WORKER_CONCURRENCY=1
JWT_SECRET=replace-me
APP_ORIGIN=http://localhost:3101
CORS_ALLOWED_ORIGINS=http://localhost:3101,https://clippingkk.annatarhe.com,https://clippingkk-api.annatarhe.com
ROOT_USERS=1
DEBUG=true

# Evonia Gate: sign-in, product permissions, and billing
# Provisioning, roles, and billing setup: docs/gate-provisioning.md
# Local Gate URL; for production use https://evonia-gate.annatarhe.com.
GATE_BASE_URL=http://localhost:3621
# Register a confidential web OIDC client with scopes: openid profile email offline_access.
# Register the callback at APP_ORIGIN's origin + /api/auth/callback
# (locally: http://localhost:3101/api/auth/callback).
GATE_CLIENT_ID=
GATE_CLIENT_SECRET=
# The iOS app's native (public) OIDC client. Register it with offline_access and the
# redirect URI com.annatarhe.clippingkk://oauth/callback. See docs/native-ios.md.
GATE_NATIVE_CLIENT_ID=
# IDs of the ClippingKK project and its billing environment in Gate.
GATE_PROJECT_ID=
GATE_ENVIRONMENT_ID=
# Server-only, project-restricted service key with project:read, project:update,
# billing:read, billing:manage, and credential:manage permissions.
# Account deletion needs access to every environment holding this product's billing accounts.
GATE_API_KEY=
# Token audience. This value is built into Gate's first-party audience list.
# For a custom audience/origin, add it to Gate's GATE_ALLOWED_AUDIENCES and update this value.
GATE_RESOURCE=https://clippingkk.annatarhe.com

# Legacy client compatibility
# Set to 1 only while old clients still need legacy authentication; disable after migration.
# While enabled, retain the existing JWT_SECRET (at least 8 characters), provider secrets,
# and legacy encryption keys so existing client credentials remain valid.
LEGACY_AUTH_ENABLED=0

# Verify at startup that the database carries every table and column src/server/db/schema.ts
# declares, and exit naming what is missing instead of serving per-request 42703 errors.
# Set to 0 only to boot against a database you know has drifted harmlessly.
DB_SCHEMA_CHECK=1

WECHAT_APP_ID=
WECHAT_SECRET=
X_BASIC_AES_KEY=27fa3e2b4bb2a
X_BASIC_AES_IV=091DD8C6AE176803467822616FC7F35E
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Authentication and messaging integrations
# Configure browser sign-in providers and verification/reset email in Gate.
# Keep these ClippingKK integration settings for existing compatibility and messaging uses.
CF_TURNSTILE_SECRET=
LEAN_CLOUD_HOST=https://clippingkk-lc.annatarhe.cn
LEAN_CLOUD_APP_ID=
LEAN_CLOUD_APP_KEY=
APPLE_AUTH_REDIRECT_URI=
APPLE_AUTH_TEAM_ID=
APPLE_AUTH_KEY_ID=
APPLE_AUTH_SERVICE_ID=
APPLE_AUTH_APP_PKG=
APPLE_AUTH_PRIVATE_KEY_BASE64=

# Payments: see docs/billing.md.
# Stripe lives in Gate (environment Stripe connection, `premium` plan, webhook at
# /api/v1/webhooks/stripe/{environmentId}); ClippingKK holds no Stripe keys.
# App Store subscriptions from the iOS app are verified here and written to Gate.
APPLE_IAP_BUNDLE_ID=com.annatarhe.clippingkk.clippingkk-ios
# The app's numeric Apple ID (App Store Connect > App Information). Required in production.
APPLE_IAP_APP_APPLE_ID=1537830952
APPLE_IAP_PRODUCT_IDS=com.annatarhe.clippingkk.premium.monthly,com.annatarhe.clippingkk.premium.yearly
# 1 accepts sandbox purchases (App Review, TestFlight). Set 0 to refuse them.
APPLE_IAP_ALLOW_SANDBOX=1
# 1 accepts unsigned Xcode StoreKit-testing transactions outside production.
APPLE_IAP_ALLOW_XCODE=0
WENQU_ENDPOINT=https://wenqu.annatarhe.cn/api/v1
WENQU_TOKEN=
# Required only for AI generation; use a model supported by the installed OpenAI adapter.
OPENAI_API_KEY=
OPENAI_MODEL=
MORALIS_KEY=
RESEND_API_KEY=
S3_ENDPOINT=https://s3.bitiful.net
S3_REGION=cn-east-1
S3_BUCKET=
S3_HOST=https://ck-cdn.annatarhe.cn
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Observability
SENTRY_DSN=
OTEL_EXPORTER_OTLP_ENDPOINT=
